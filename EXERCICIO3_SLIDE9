Atividade-3
Um arquivo binário chamado clientes.bin armazena vários registros da
struct Cliente (contendo conta_corrente (int), nome (char[50]) e saldo (float)).
O que o algoritmo deve fazer:
a) Solicitar ao usuário o número de uma conta corrente e um valor de
depósito/saque.
b) Abrir o arquivo binário em modo de leitura/escrita ("rb+").
c) Ler o arquivo de registro em registro. Ao encontrar a conta correspondente,
atualizar o campo saldo.
d) Utilizar a função fseek() para voltar o ponteiro do arquivo para a posição exata
daquele cliente e sobrescrever o registro antigo com o atualizado.
----------------------------------------------------------------------------------

#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int conta_corrente;
    char nome[50];
    float saldo;
} Cliente;

int main() {

    FILE *arquivo;
    Cliente cliente;

    int conta;
    float valor;
    int encontrado = 0;

    printf("Numero da conta: ");
    scanf("%d", &conta);

    printf("Valor (positivo = deposito | negativo = saque): ");
    scanf("%f", &valor);

    arquivo = fopen("clientes.bin", "rb+");

    if (arquivo == NULL) {
        printf("Erro ao abrir o arquivo.\n");
        return 1;
    }

    while (fread(&cliente, sizeof(Cliente), 1, arquivo) == 1) {

        if (cliente.conta_corrente == conta) {

            cliente.saldo += valor;

            fseek(arquivo, -sizeof(Cliente), SEEK_CUR);

            fwrite(&cliente, sizeof(Cliente), 1, arquivo);

            encontrado = 1;

            printf("\nConta encontrada!\n");
            printf("Cliente: %s\n", cliente.nome);
            printf("Novo saldo: R$ %.2f\n", cliente.saldo);

            break;
        }
    }

    if (!encontrado) {
        printf("\nConta nao encontrada.\n");
    }

    fclose(arquivo);

    return 0;
}
