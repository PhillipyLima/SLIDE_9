------------------------------------------------
Atividade 1: Crie um algoritmo para gerenciar o estoque
de uma loja de eletrônicos. Cada item possui codigo (int),
nome (char[50]) e preco (float).
O que o algoritmo deve fazer:
a) Receber os dados de 3 produtos via teclado,
armazená-los em um vetor de struct.
b) Salvar esses dados em um arquivo de texto chamado
estoque.txt (um produto por linha).
c) Fechar o arquivo, abri-lo novamente para leitura e
exibir os produtos na tela com um layout organizado.
------------------------------------------------------

#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int codigo;
    char nome[50];
    float preco;
} Produto;

int main() {

    Produto produtos[3];
    FILE *arquivo;
    int i;

    // Cadastro dos produtos
    printf("=== CADASTRO DOS PRODUTOS ===\n\n");

    for(i = 0; i < 3; i++) {

        printf("Produto %d\n", i + 1);

        printf("Codigo: ");
        scanf("%d", &produtos[i].codigo);

        printf("Nome: ");
        scanf(" %[^\n]", produtos[i].nome);

        printf("Preco: ");
        scanf("%f", &produtos[i].preco);

        printf("\n");
    }

    // Gravação no arquivo
    arquivo = fopen("estoque.txt", "w");

    if(arquivo == NULL) {
        printf("Erro ao criar o arquivo.\n");
        return 1;
    }

    for(i = 0; i < 3; i++) {

        fprintf(arquivo,
                "%d;%s;%.2f\n",
                produtos[i].codigo,
                produtos[i].nome,
                produtos[i].preco);
    }

    fclose(arquivo);

    // Leitura do arquivo
    arquivo = fopen("estoque.txt", "r");

    if(arquivo == NULL) {
        printf("Erro ao abrir o arquivo.\n");
        return 1;
    }

    printf("\n=============================================\n");
    printf("              ESTOQUE DA LOJA\n");
    printf("=============================================\n");
    printf("%-10s %-20s %-10s\n",
           "CODIGO",
           "NOME",
           "PRECO");
    printf("---------------------------------------------\n");

    Produto p;

    while(fscanf(arquivo,
                 "%d;%49[^;];%f\n",
                 &p.codigo,
                 p.nome,
                 &p.preco) == 3) {

        printf("%-10d %-20s R$ %-8.2f\n",
               p.codigo,
               p.nome,
               p.preco);
    }

    fclose(arquivo);

    return 0;
}
